[
    {
        "name": "Honesty is the best policy.",
        "trans": [
            "诚实不欺为上策。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Practice makes perfect.",
        "trans": [
            "熟能生巧。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "It is never too old to learn.",
        "trans": [
            "活到老，学到老。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Reading is to the mind while exercise to the body.",
        "trans": [
            "读书健脑，运动强身。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A man becomes learned by asking questions.",
        "trans": [
            "不耻下问才能有学问。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Learn and live.",
        "trans": [
            "活着，为了学习。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time flies.",
        "trans": [
            "光阴似箭。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Knowledge starts with practice.",
        "trans": [
            "实践出真知。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Complacency is the enemy of study.",
        "trans": [
            "学习的敌人是自己的满足。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Knowledge makes humble; ignorance makes proud.",
        "trans": [
            "知识使人谦虚，无知使人傲慢。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Knowledge advances by steps and not by leaps.",
        "trans": [
            "知识只能循序渐进，不能跃进。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A man can do no more than he can.",
        "trans": [
            "凡事都应量力而行。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Books and friends should be few but good.",
        "trans": [
            "读书如交友，应求少而精。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A man cannot spin and reel at the same time.",
        "trans": [
            "一心不能二用。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Where there is a will, there is a way.",
        "trans": [
            "有志者事竟成。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "No pains, no gains.",
        "trans": [
            "没有付出就没有收获。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Constant dripping wears away a stone.",
        "trans": [
            "水滴石穿，绳锯木断。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Four eyes see more than two.",
        "trans": [
            "集思广益。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Care and diligence bring luck.",
        "trans": [
            "谨慎和勤奋才能抓住机遇。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Genius is nothing but labor and diligence.",
        "trans": [
            "天才不过是勤奋而已。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Great hopes make great man.",
        "trans": [
            "伟大的抱负造就伟大的人物。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Industry is the parent of success.",
        "trans": [
            "勤奋是成功之母。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "No rose without a thorn.",
        "trans": [
            "没有不带刺的玫瑰。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Respect yourself, or no one else will respect you.",
        "trans": [
            "要人尊敬，必须自重。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Patience is the best remedy.",
        "trans": [
            "忍耐是良药。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "One good turn deserves another.",
        "trans": [
            "行善积德。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "He knows most who speaks least.",
        "trans": [
            "大智若愚。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A still tongue makes a wise head.",
        "trans": [
            "寡言者智。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A candle lights others and consumes itself.",
        "trans": [
            "蜡烛照亮别人，却毁灭了自己。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "He is not fit to command others that cannot command himself.",
        "trans": [
            "正人须先正己。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Pride goes before, and shame comes after.",
        "trans": [
            "骄傲使人落后。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Please the eye and plague the heart.",
        "trans": [
            "贪图一时快活，必然留下隐祸。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "The early bird catches the worm.",
        "trans": [
            "早起的鸟儿有虫吃。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "He who makes constant complaint gets little compassion.",
        "trans": [
            "经常诉苦，没入同情。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Do as you would be done by.",
        "trans": [
            "己所不欲，勿施于人。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Birds of a feather flock together.",
        "trans": [
            "物以类聚，人以群分。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A man is known by his friends.",
        "trans": [
            "什么人交什么朋友。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Keep good men company and you shall be of the number.",
        "trans": [
            "近朱者赤，近墨者黑。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A friend in need is a friend indeed.",
        "trans": [
            "患难见真情。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A faithful friend is hard to find.",
        "trans": [
            "知音难觅。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A friend is never known till a man has need.",
        "trans": [
            "需要之时方知友。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Misfortune tests the sincerity of friends.",
        "trans": [
            "患难见真情。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time and tide wait for no man.",
        "trans": [
            "时不我待。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "To save time is to lengthen life.",
        "trans": [
            "节约时间就是延长生命。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time stays not the fool's leisure.",
        "trans": [
            "时间不等闲逛的傻瓜。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Lost years are worse than lost dollars.",
        "trans": [
            "失去时光金不换。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time is money.",
        "trans": [
            "时间就是金钱。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time has wings.",
        "trans": [
            "光阴去如飞。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Time lost cannot be won again.",
        "trans": [
            "时光一去不复返。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Gold will not buy anything.",
        "trans": [
            "黄金不能买尽一切。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "The chief aim of man is not to get money.",
        "trans": [
            "人的主要目的并不是赚钱。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "What is wealth good for, if it brings melancholy?",
        "trans": [
            "财富如带忧郁来，有了财富有何用？"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Wealth makes worship.",
        "trans": [
            "财富能使人拜倒。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "An apple a day keeps the doctor away.",
        "trans": [
            "一天一苹果，不用请医生。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Prevention is better than cure.",
        "trans": [
            "预防胜于治疗。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "All work and no play makes Jack a dull boy.",
        "trans": [
            "只工作，不玩耍，聪明小伙也变傻。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Health is not valued till sickness comes.",
        "trans": [
            "病时方知健康可贵。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "A good medicine tastes bitter.",
        "trans": [
            "良药苦口。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Good health is over wealth.",
        "trans": [
            "健康是最大的财富。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Happiness lies first of all in health.",
        "trans": [
            "幸福首先在于健康。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Cheerfulness is health; its opposite, melancholy, is disease.",
        "trans": [
            "欢乐就是健康，忧郁就是病痛。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "He is happy that thinks himself so.",
        "trans": [
            "自乐者常乐。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Content is better than riches.",
        "trans": [
            "知足者常乐。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "All that glitters is not gold.",
        "trans": [
            "闪光的不一定都是金子。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "All things are difficult before they are easy.",
        "trans": [
            "凡事总是由难而易。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Every advantage has its disadvantage.",
        "trans": [
            "有利必有弊。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Every man has his faults.",
        "trans": [
            "金无足赤，人无完人。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "He laughs best who laughs last.",
        "trans": [
            "谁笑到最后，谁笑得最好。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "It is the first step that costs troublesome.",
        "trans": [
            "万事开头难。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "The farthest way about is the nearest way home.",
        "trans": [
            "抄近路反而绕远路。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Take things as they come.",
        "trans": [
            "既来之，则安之。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Every man is the architect of his own fortune.",
        "trans": [
            "自己的命运自己掌握。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "It is no use crying over spilt milk.",
        "trans": [
            "覆水难收。"
        ],
        "usphone": "",
        "ukphone": ""
    },
    {
        "name": "Don't trouble trouble until trouble troubles you.",
        "trans": [
            "不要自找麻烦。"
        ],
        "usphone": "",
        "ukphone": ""
    }
]
